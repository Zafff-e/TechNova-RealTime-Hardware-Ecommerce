<%- include('partials/header', { pageTitle: 'Checkout' }) %>

<div class="page-container">
  <h1 style="font-family: 'Space Grotesk', sans-serif; font-size: 2rem; font-weight: 800; color: white; margin-bottom: 28px;">Checkout</h1>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert-error" style="max-width: 600px; margin-bottom: 20px;"><%= error %></div>
  <% } %>

  <div style="display: grid; grid-template-columns: 1fr 360px; gap: 24px;">

    <!-- Checkout Form -->
    <div style="background: var(--bg-card); border: 1px solid var(--border-light); border-radius: var(--radius); padding: 28px;">
      <h2 style="font-size: 1.2rem; font-weight: 700; color: white; margin-bottom: 20px; border-bottom: 1px solid var(--border-light); padding-bottom: 14px;">Delivery Information</h2>

      <form action="/checkout" method="POST">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
          <div class="form-group" style="margin: 0;">
            <label class="form-label">Full Name</label>
            <input type="text" class="form-input" value="<%= user.name %>" disabled style="opacity: 0.7;">
          </div>
          <div class="form-group" style="margin: 0;">
            <label class="form-label">Email</label>
            <input type="email" class="form-input" value="<%= user.email %>" disabled style="opacity: 0.7;">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Phone Number *</label>
          <input type="tel" name="phone" class="form-input" value="<%= user.phone || '' %>" placeholder="01XXXXXXXXX" required>
        </div>

        <div class="form-group">
          <label class="form-label">Delivery Address *</label>
          <textarea name="deliveryAddress" class="form-textarea" required rows="3"
            placeholder="House #, Road #, Area, City, Postcode"><%= user.address || '' %></textarea>
        </div>

        <div style="background: rgba(245,158,11,0.05); border: 1px solid rgba(245,158,11,0.15); border-radius: 12px; padding: 16px; margin-bottom: 20px;">
          <div style="font-weight: 700; color: #fcd34d; margin-bottom: 8px;">💳 Payment Method</div>
          <div style="display: flex; align-items: center; gap: 10px; color: var(--text-secondary); font-size: 0.9rem;">
            <input type="radio" checked readonly id="cod"> <label for="cod"><strong style="color: white;">Cash on Delivery</strong> — Pay when your package arrives</label>
          </div>
        </div>

        <div class="alert-info" style="font-size: 0.85rem;">
          📧 After placing the order, a <strong>6-digit confirmation code</strong> will be sent to <strong><%= user.email %></strong> to verify your order.
        </div>

        <button type="submit" class="btn-primary" style="margin-top: 20px;">
          📦 Place Order & Get Confirmation Code
        </button>
      </form>
    </div>

    <!-- Order Summary Sidebar -->
    <div class="cart-summary" style="position: sticky; top: 90px; height: fit-content;">
      <h3>Your Order</h3>
      <% cart.forEach(item => { %>
        <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border-light);">
          <img src="<%= item.imagePath %>" style="width: 45px; height: 45px; object-fit: contain; background: #0d1526; border-radius: 6px; padding: 4px; flex-shrink: 0;">
          <div style="flex: 1; min-width: 0;">
            <div style="font-size: 0.85rem; font-weight: 600; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= item.name %></div>
            <div style="font-size: 0.78rem; color: var(--text-muted);">Qty: <%= item.quantity %></div>
          </div>
          <div style="font-size: 0.875rem; font-weight: 700; color: var(--accent-light); flex-shrink: 0;">BDT <%= (item.price * item.quantity).toLocaleString('en-BD') %></div>
        </div>
      <% }) %>
      <div class="summary-row"><span>Subtotal</span><span>BDT <%= subtotal.toLocaleString('en-BD') %></span></div>
      <div class="summary-row"><span>Delivery Fee</span><span>BDT <%= deliveryFee %></span></div>
      <div class="summary-row total"><span>Total</span><span>BDT <%= total.toLocaleString('en-BD') %></span></div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
