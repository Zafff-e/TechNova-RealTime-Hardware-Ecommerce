<!-- Initialize cart badge on load -->
<script>
  (function() {
    const count = <%= JSON.stringify(cartCount || 0) %>;
    if (count > 0) {
      const badge = document.getElementById('floating-cart-badge');
      if (badge) { badge.textContent = count; badge.style.display = 'flex'; }
    }
  })();
</script>

