<%- include('../partials/header', { pageTitle: 'Manage Products' }) %>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-nav-title">Management</div>
    <a href="/admin" class="admin-nav-link">📊 Dashboard</a>
    <a href="/admin/products" class="admin-nav-link active">📦 Products</a>
    <a href="/admin/orders" class="admin-nav-link">🛒 Orders</a>
  </aside>

  <div class="admin-main">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h1 style="font-family: 'Space Grotesk', sans-serif; font-size: 2rem; font-weight: 800; color: white;">Manage Products</h1>
      <button class="btn-primary" id="btn-add-product" style="width: auto; padding: 10px 24px;">+ Add Product</button>
    </div>

    <!-- Real-time Admin Product Search -->
    <div style="margin-bottom: 24px; position: relative; max-width: 450px;">
      <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;">🔍</span>
      <input type="text" id="admin-product-search" placeholder="Quick filter products by name or category..." class="form-input" style="padding-left: 36px; width: 100%; height: 42px; background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary); border-radius: var(--radius); outline: none;">
    </div>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert-success"><%= success %></div><% } %>

    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Name & Category</th>
            <th>Price</th>
            <th>Stock / Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(p => { %>
            <tr>
              <td><img src="<%= p.imagePath %>" style="width: 50px; height: 50px; object-fit: contain; background: #0d1526; border-radius: 6px; padding: 4px;"></td>
              <td>
                <div style="font-weight: 600; color: white; margin-bottom: 4px;"><%= p.name %></div>
                <div style="font-size: 0.8rem; color: var(--text-muted);"><%= p.category %> &bull; <%= p.brand || 'No Brand' %></div>
              </td>
              <td>
                <div style="font-weight: 600; color: var(--accent-light);">BDT <%= p.price.toLocaleString('en-BD') %></div>
                <% if(p.originalPrice) { %><div style="font-size: 0.8rem; color: var(--text-muted); text-decoration: line-through;">BDT <%= p.originalPrice.toLocaleString('en-BD') %></div><% } %>
              </td>
              <td>
                <% if(p.isPreOrder) { %>
                  <span class="status-badge" style="background: rgba(139,92,246,0.15); color: #c084fc;">Pre-Order</span>
                <% } else if(p.stock > 0) { %>
                  <div style="font-weight: 600;"><%= p.stock %> <span style="color: var(--text-muted); font-weight: normal; font-size: 0.8rem;">units</span></div>
                <% } else { %>
                  <span class="status-badge status-cancelled">Out of Stock</span>
                <% } %>
              </td>
              <td>
                <div style="display: flex; gap: 8px;">
                  <button class="btn-secondary edit-product-btn" 
                    data-id="<%= p._id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" 
                    data-stock="<%= p.stock %>" data-category="<%= p.category %>" data-brand="<%= p.brand %>"
                    data-description="<%= p.description %>" data-ispreorder="<%= p.isPreOrder %>" data-isfeatured="<%= p.isFeatured %>"
                    style="padding: 6px 12px; font-size: 0.8rem;">Edit</button>
                  <form action="/admin/products/delete" method="POST" style="margin:0;" onsubmit="return confirm('Delete this product?');">
                    <input type="hidden" name="productId" value="<%= p._id %>">
                    <button type="submit" class="btn-secondary" style="padding: 6px 12px; font-size: 0.8rem; color: #fca5a5; border-color: rgba(239,68,68,0.3);">Del</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add Product Modal -->
<div class="modal-overlay" id="product-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(5px);">
  <div class="form-card" style="width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto;" onclick="event.stopPropagation()">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h2 style="font-size: 1.5rem; color: white;">Add New Product</h2>
      <button class="modal-close" style="background: none; border: none; color: white; font-size: 1.5rem; cursor: pointer;">&times;</button>
    </div>
    <form action="/admin/products/create" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label class="form-label">Product Name</label>
        <input type="text" name="name" class="form-input" required>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <div class="form-group">
          <label class="form-label">Price (BDT)</label>
          <input type="number" name="price" class="form-input" required min="0" step="0.01">
        </div>
        <div class="form-group">
          <label class="form-label">Original Price (Optional)</label>
          <input type="number" name="originalPrice" class="form-input" min="0" step="0.01">
        </div>
        <div class="form-group">
          <label class="form-label">Category</label>
          <select name="category" class="form-input form-select" required>
            <option value="CPU">CPU</option><option value="GPU">GPU</option>
            <option value="RAM">RAM</option><option value="Storage">Storage</option>
            <option value="Motherboard">Motherboard</option><option value="Laptop">Laptop</option>
            <option value="Monitor">Monitor</option><option value="Accessories">Accessories</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Brand</label>
          <input type="text" name="brand" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label">Stock Quantity</label>
          <input type="number" name="stock" class="form-input" value="10" min="0">
        </div>
        <div class="form-group">
          <label class="form-label">Pre-Order ETA</label>
          <input type="text" name="preOrderETA" class="form-input" placeholder="e.g. Next Week">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-textarea" rows="3"></textarea>
      </div>
      <div class="form-group">
        <label class="form-label">Product Image</label>
        <input type="file" name="image" class="form-input" accept="image/*" required>
      </div>
      <div style="display: flex; gap: 20px; margin-bottom: 20px;">
        <label style="display: flex; align-items: center; gap: 8px; color: white; font-size: 0.9rem;"><input type="checkbox" name="isPreOrder"> Is Pre-Order?</label>
        <label style="display: flex; align-items: center; gap: 8px; color: white; font-size: 0.9rem;"><input type="checkbox" name="isFeatured"> Featured Product?</label>
      </div>
      <button type="submit" class="btn-primary">Save Product</button>
    </form>
  </div>
</div>

<!-- Edit Product Modal -->
<div class="modal-overlay" id="edit-product-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(5px);">
  <div class="form-card" style="width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto;" onclick="event.stopPropagation()">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h2 style="font-size: 1.5rem; color: white;">Edit Product</h2>
      <button class="modal-close" style="background: none; border: none; color: white; font-size: 1.5rem; cursor: pointer;">&times;</button>
    </div>
    <form action="/admin/products/update" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="productId" id="edit-product-id">
      <div class="form-group"><label class="form-label">Product Name</label><input type="text" name="name" id="edit-product-name" class="form-input" required></div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <div class="form-group"><label class="form-label">Price (BDT)</label><input type="number" name="price" id="edit-product-price" class="form-input" required step="0.01"></div>
        <div class="form-group"><label class="form-label">Stock</label><input type="number" name="stock" id="edit-product-stock" class="form-input" min="0"></div>
        <div class="form-group"><label class="form-label">Category</label><input type="text" name="category" id="edit-product-category" class="form-input"></div>
        <div class="form-group"><label class="form-label">Brand</label><input type="text" name="brand" id="edit-product-brand" class="form-input"></div>
      </div>
      <div class="form-group"><label class="form-label">Description</label><textarea name="description" id="edit-product-desc" class="form-textarea" rows="3"></textarea></div>
      <div class="form-group"><label class="form-label">Update Image (Optional)</label><input type="file" name="image" class="form-input" accept="image/*"></div>
      <div style="display: flex; gap: 20px; margin-bottom: 20px;">
        <label style="display: flex; align-items: center; gap: 8px; color: white; font-size: 0.9rem;"><input type="checkbox" name="isPreOrder" id="edit-preorder"> Is Pre-Order?</label>
        <label style="display: flex; align-items: center; gap: 8px; color: white; font-size: 0.9rem;"><input type="checkbox" name="isFeatured" id="edit-featured"> Featured?</label>
      </div>
      <button type="submit" class="btn-primary">Update Product</button>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const addModal = document.getElementById('product-modal');
    const editModal = document.getElementById('edit-product-modal');
    
    document.querySelectorAll('.modal-overlay').forEach(el => el.style.display = 'none');

    const addBtn = document.getElementById('btn-add-product');
    if (addBtn) {
      addBtn.addEventListener('click', () => {
        addModal.style.display = 'flex';
      });
    }

    document.querySelectorAll('.modal-close').forEach(btn => {
      btn.addEventListener('click', function() {
        this.closest('.modal-overlay').style.display = 'none';
      });
    });

    document.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', function(e) {
        if (e.target === this) this.style.display = 'none';
      });
    });

    document.querySelectorAll('.edit-product-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const dataset = this.dataset;
        document.getElementById('edit-product-id').value = dataset.id;
        document.getElementById('edit-product-name').value = dataset.name;
        document.getElementById('edit-product-price').value = dataset.price;
        document.getElementById('edit-product-stock').value = dataset.stock;
        document.getElementById('edit-product-category').value = dataset.category;
        document.getElementById('edit-product-brand').value = dataset.brand;
        document.getElementById('edit-product-desc').value = dataset.description;
        document.getElementById('edit-preorder').checked = dataset.ispreorder === 'true';
        document.getElementById('edit-featured').checked = dataset.isfeatured === 'true';
        
        editModal.style.display = 'flex';
      });
    });
  });
</script>

<%- include('../partials/footer') %>
