<%- include('partials/header', { pageTitle: 'Confirm Order' }) %>

<div class="form-page">
  <div class="form-card">
    <div class="form-header">
      <div class="form-icon">📦</div>
      <h2>Confirm Your Order</h2>
      <p>Enter the 6-digit code sent to your email to confirm your Cash on Delivery order.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert-error"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert-success"><%= success %></div>
    <% } %>

    <div class="alert-info" style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.2); color: #059669;">
      <strong>Verification Code:</strong> <span style="font-size: 1.2rem; letter-spacing: 2px;">123456</span>
    </div>

    <form action="/verify-order" method="POST">
      <input type="hidden" name="otp" id="otp-hidden">
      <div class="otp-inputs">
        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric">
        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric">
        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric">
        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric">
        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric">
        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric">
      </div>
      <button type="submit" class="btn-primary btn-green">✅ Confirm Order</button>
    </form>

    <a href="/" class="btn-secondary" style="margin-top: 8px; display: block; text-align: center;">Cancel & Go Home</a>
  </div>
</div>

<%- include('partials/footer') %>
