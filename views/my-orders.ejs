<%- include('partials/header', { pageTitle: 'My Orders' }) %>

<div class="page-container">
  <h1 style="font-family: 'Space Grotesk', sans-serif; font-size: 2rem; font-weight: 800; color: white; margin-bottom: 28px;">My Orders</h1>

  <% if (orders.length === 0) { %>
    <div style="text-align: center; padding: 80px 20px; color: var(--text-muted);">
      <div style="font-size: 4rem; margin-bottom: 16px;">📦</div>
      <h3 style="color: var(--text-secondary); margin-bottom: 12px;">No orders yet</h3>
      <p style="margin-bottom: 24px;">Looks like you haven't placed any orders.</p>
      <a href="/shop" class="btn-primary" style="display: inline-block; width: auto; padding: 12px 32px; text-decoration: none;">Start Shopping</a>
    </div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: 24px;">
      <% orders.forEach(order => { %>
        <div class="table-container" data-order-id="<%= order._id %>" style="padding: 24px;">
          
          <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; border-bottom: 1px solid var(--border-light); padding-bottom: 16px; margin-bottom: 20px;">
            <div>
              <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Order ID</div>
              <div style="font-weight: 700; color: white; font-size: 1.1rem;"><%= order.orderId %></div>
            </div>
            <div>
              <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Placed On</div>
              <div style="color: var(--text-secondary);"><%= order.placedAt.toLocaleDateString() %></div>
            </div>
            <div>
              <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Total</div>
              <div style="font-weight: 700; color: var(--accent-light);">BDT <%= order.totalAmount.toLocaleString('en-BD') %></div>
            </div>
            <div>
              <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Status</div>
              <%
                let statusClass = 'status-placed';
                if(order.status === 'Packaging') statusClass = 'status-packaging';
                if(order.status === 'Dispatched') statusClass = 'status-dispatched';
                if(order.status === 'Out for Delivery') statusClass = 'status-out';
                if(order.status === 'Delivered') statusClass = 'status-delivered';
                if(order.status === 'Cancelled') statusClass = 'status-cancelled';
              %>
              <div class="status-badge <%= statusClass %>"><%= order.status %></div>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 300px; gap: 40px;">
            
            <!-- Items List -->
            <div>
              <h4 style="font-size: 0.9rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 16px;">Items</h4>
              <% order.items.forEach(item => { %>
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; background: rgba(255,255,255,0.02); padding: 8px; border-radius: 8px;">
                  <img src="<%= item.imagePath %>" style="width: 40px; height: 40px; object-fit: contain; background: #0d1526; border-radius: 6px; padding: 4px;">
                  <div style="flex: 1;">
                    <div style="font-size: 0.85rem; color: white;"><%= item.name %></div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Qty: <%= item.quantity %> &times; BDT <%= item.price.toLocaleString('en-BD') %></div>
                  </div>
                </div>
              <% }) %>
            </div>

            <!-- Delivery Tracker -->
            <div>
              <h4 style="font-size: 0.9rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 16px;">Tracking</h4>
              
              <div class="status-tracker">
                <% 
                  const stages = ['Order Placed', 'Packaging', 'Dispatched', 'Out for Delivery', 'Delivered'];
                  let currentIdx = stages.indexOf(order.status);
                  if (order.status === 'Cancelled') currentIdx = -1;
                  
                  stages.forEach((stage, idx) => {
                    let stepClass = '';
                    if (idx < currentIdx) stepClass = 'done';
                    if (idx === currentIdx) stepClass = 'active';
                    
                    const historyLog = order.statusHistory.find(h => h.status === stage);
                %>
                  <div class="status-step <%= stepClass %>">
                    <div class="step-dot">
                      <% if (idx < currentIdx) { %>✓<% } else if (idx === currentIdx) { %>•<% } else { %><%= idx+1 %><% } %>
                    </div>
                    <div class="step-content">
                      <div class="step-label"><%= stage %></div>
                      <% if (historyLog) { %>
                        <div class="step-time"><%= new Date(historyLog.timestamp).toLocaleString([], {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'}) %></div>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>

              <!-- Delivery QR Code Confirmation -->
              <% if (order.status === 'Delivered') { %>
                <div style="margin-top: 20px; padding: 16px; background: rgba(16,185,129,0.05); border: 1px solid rgba(16,185,129,0.2); border-radius: 12px; text-align: center;">
                  <% if (!order.receiptConfirmed) { %>
                    <h5 style="color: var(--green); margin-bottom: 8px; font-size: 0.95rem;">Confirm Receipt</h5>
                    <p style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 12px;">Scan this QR with the delivery agent or click below to confirm receipt.</p>
                    <% if (order.qrCodeData) { %>
                      <div class="qr-block"><img src="<%= order.qrCodeData %>" alt="QR"></div>
                    <% } %>
                    <form action="/order/confirm-receipt/<%= order._id %>" method="POST">
                      <button class="btn-primary btn-green" style="padding: 10px; font-size: 0.85rem;">I received the package</button>
                    </form>
                  <% } else { %>
                    <div style="font-size: 2rem; margin-bottom: 8px;">✅</div>
                    <h5 style="color: var(--green); font-size: 0.95rem;">Receipt Confirmed</h5>
                    <p style="font-size: 0.8rem; color: var(--text-secondary);">Enjoy your hardware!</p>
                  <% } %>
                </div>
              <% } %>
              
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
