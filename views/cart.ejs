<%- include('partials/header', { pageTitle: 'My Cart' }) %>

<div class="page-container">
  <h1 style="font-family: 'Space Grotesk', sans-serif; font-size: 2rem; font-weight: 800; color: white; margin-bottom: 28px;">
    🛒 Shopping Cart
    <% if(cart.length > 0) { %><span style="font-size: 1rem; color: var(--text-muted); font-weight: 400; font-family: Inter, sans-serif;">(<%= cart.reduce((s,i)=>s+i.quantity,0) %> items)</span><% } %>
  </h1>

  <% if (cart.length === 0) { %>
    <div style="text-align: center; padding: 80px 20px; color: var(--text-muted);">
      <div style="font-size: 5rem; margin-bottom: 20px;">🛒</div>
      <h3 style="color: var(--text-secondary); margin-bottom: 12px;">Your cart is empty</h3>
      <p style="margin-bottom: 24px;">Add some tech hardware to get started!</p>
      <a href="/shop" class="btn-primary" style="display: inline-block; width: auto; padding: 12px 32px; text-decoration: none;">Browse Products</a>
    </div>
  <% } else { %>
    <div class="cart-layout">
      <!-- Cart Items -->
      <div class="cart-items-container">
        <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center;">
          <span style="font-weight: 700; color: white;">Items</span>
        </div>

        <% cart.forEach(item => { %>
          <div class="cart-item-row">
            <img src="<%= item.imagePath %>" alt="<%= item.name %>" class="cart-item-img">
            <div class="cart-item-info">
              <div class="cart-item-name"><%= item.name %></div>
              <div class="cart-item-price">
                <% if(item.originalPrice && item.originalPrice > item.price) { %>
                  <span style="text-decoration: line-through; color: var(--text-muted); font-size: 0.85rem; margin-right: 8px;">BDT <%= item.originalPrice.toLocaleString('en-BD') %></span>
                <% } %>
                BDT <%= item.price.toLocaleString('en-BD') %> each
              </div>
              <% if(item.originalPrice && item.originalPrice > item.price) { %>
                <div style="color: var(--green); font-size: 0.8rem; font-weight: 600; margin-top: 4px;">Save BDT <%= (item.originalPrice - item.price).toLocaleString('en-BD') %>!</div>
              <% } %>
              <% if(item.isPreOrder) { %><span style="font-size: 0.7rem; background: rgba(139,92,246,0.2); color: #c084fc; padding: 2px 8px; border-radius: 4px;">Pre-Order</span><% } %>
            </div>
            <div class="cart-qty-controls">
              <form action="/cart/remove" method="POST" style="margin: 0;">
                <input type="hidden" name="productId" value="<%= item.productId %>">
                <button type="submit" class="qty-btn qty-minus">−</button>
              </form>
              <span class="qty-value"><%= item.quantity %></span>
              <form action="/cart/add" method="POST" style="margin: 0;">
                <input type="hidden" name="productId" value="<%= item.productId %>">
                <button type="submit" class="qty-btn qty-plus">+</button>
              </form>
            </div>
            <div class="cart-item-total">BDT <%= (item.price * item.quantity).toLocaleString('en-BD') %></div>
            <form action="/cart/remove-all" method="POST" style="margin: 0;">
              <input type="hidden" name="productId" value="<%= item.productId %>">
              <button type="submit" class="cart-remove" title="Remove item">🗑</button>
            </form>
          </div>
        <% }) %>
      </div>

      <!-- Order Summary -->
      <div class="cart-summary">
        <h3>Order Summary</h3>
        <div class="summary-row"><span>Subtotal</span><span>BDT <%= subtotal.toLocaleString('en-BD') %></span></div>
        <div class="summary-row"><span>Delivery Fee</span><span>BDT <%= deliveryFee.toLocaleString('en-BD') %></span></div>
        <div class="summary-row total"><span>Total</span><span>BDT <%= total.toLocaleString('en-BD') %></span></div>

        <div style="margin: 16px 0; padding: 12px; background: rgba(16,185,129,0.05); border: 1px solid rgba(16,185,129,0.15); border-radius: 10px; font-size: 0.82rem; color: var(--text-secondary);">
          🚚 <strong>Cash on Delivery</strong> — Pay when your package arrives!<br>
          📧 You'll receive an OTP email to confirm your order.
        </div>

        <a href="/checkout" class="btn-primary" style="text-decoration:none; display: flex; align-items: center; justify-content: center; gap: 8px;">
          Proceed to Checkout →
        </a>
        <a href="/shop" class="btn-secondary" style="display: block; text-align: center; margin-top: 8px;">Continue Shopping</a>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
